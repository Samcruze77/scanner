{
  "name": "docuscanner-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-ocr-assets.mjs && node scripts/copy-pdf-assets.mjs && node scripts/copy-font-assets.mjs && node scripts/copy-qpdf-assets.mjs && node scripts/copy-notices.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-ocr-assets.mjs && node scripts/copy-pdf-assets.mjs && node scripts/copy-font-assets.mjs && node scripts/copy-qpdf-assets.mjs && node scripts/copy-notices.mjs",
    "build": "next build",
    "postbuild": "node scripts/verify-theme-css.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:pdf2excel": "node tests/pdf2excel/geometry.mjs && node tests/pdf2excel/csv.mjs",
    "test:docx": "node tests/docx/compare.mjs",
    "test:docx:robust": "node tests/docx/robustness.mjs",
    "test:docx:fonts": "node tests/docx/fonts.mjs",
    "test:docx:boundaries": "node tests/docx/boundaries.mjs",
    "test:protect": "node tests/protect/run.mjs",
    "test:compress": "node tests/compress/run.mjs",
    "test:compress:readability": "node tests/compress/readability.mjs",
    "test:quality-fixes": "node tests/audit/verify-fixes.mjs",
    "test:pdf-edit": "node tests/audit/verify-pdf-edit.mjs",
    "test:print-quality": "node tests/audit/verify-print.mjs",
    "test:excel-pdf": "node tests/audit/verify-excel.mjs",
    "test:pdf-word": "node tests/audit/verify-pdf2word.mjs",
    "test:ocr": "node --no-warnings tests/ocr/identifiers.mjs",
    "test:ocr:ui": "node tests/audit/verify-ocr-ui.mjs",
    "test:docx:tables": "node --no-warnings tests/docx/table-widths.mjs",
    "test:images": "node --no-warnings tests/images/geometry.mjs && node --no-warnings tests/images/quality-unit.mjs",
    "test:images:e2e": "node tests/images/e2e.mjs",
    "test:images:quality": "node tests/images/quality.mjs",
    "test:image-edit": "node --no-warnings --import ./tests/scanner/register.mjs tests/images/edit-unit.mjs",
    "test:image-edit:browser": "node --no-warnings tests/images/edit-browser.mjs",
    "test:assistant": "node --no-warnings tests/assistant/knowledge.mjs && node --no-warnings tests/assistant/api.mjs",
    "test:editor": "node tests/editor/ux.mjs",
    "test:editor:images": "node tests/editor/images.mjs",
    "test:guidance": "node --no-warnings tests/guidance/preferences.mjs",
    "test:guidance:browser": "node --no-warnings --import ./tests/scanner/register.mjs tests/guidance/browser.mjs",
    "test:assistant:browser": "node tests/assistant/browser.mjs && node tests/assistant/launcher.mjs && node tests/assistant/launcher-editor.mjs",
    "test:print": "node tests/print/verify.mjs",
    "test:zoom": "node tests/zoom/verify.mjs",
    "test:auth": "node tests/auth/verify.mjs",
    "test:consent": "node tests/consent/consent.mjs",
    "test:pdf-quality": "node --no-warnings tests/pdf/crop-math.mjs && node tests/audit/verify-pdf-quality.mjs && node tests/audit/verify-pdf-auto.mjs",
    "test:scanner": "node --no-warnings --import ./tests/scanner/register.mjs tests/scanner/detection-safety.mjs --strict && node tests/scanner/camera-browser.mjs && node tests/scanner/multipage-browser.mjs",
    "test:install": "node --no-warnings tests/install/unit.mjs",
    "test:install:browser": "node tests/install/browser.mjs",
    "test:consent:browser": "node tests/consent/browser.mjs",
    "test:theme": "node tests/ui/theme.mjs",
    "test:analytics": "node tests/analytics/geo.mjs && node tests/analytics/edge-function-geo.mjs && node tests/analytics/geo-hierarchy.mjs && node tests/analytics/geography-levels.mjs && node tests/analytics/geo-providers.mjs && node tests/analytics/geo-precision.mjs && node tests/analytics/export-range.mjs && node tests/analytics/admin-summary.mjs && node tests/analytics/edge-handlers.mjs && node tests/analytics/admin-profile.mjs && node tests/analytics/export.mjs && node tests/analytics/clarity.mjs && node tests/analytics/authorization.mjs",
    "test:theme:visual": "node tests/ui/theme-visual.mjs",
    "audit:ui": "node tests/ui/audit.mjs",
    "test:word-creator": "node --no-warnings --import ./tests/scanner/register.mjs tests/wordCreator/unit.mjs && node --no-warnings --import ./tests/scanner/register.mjs tests/wordCreator/layout-rules.mjs",
    "test:word-creator:browser": "node tests/wordCreator/browser.mjs",
    "test:word-creator:layout": "node tests/wordCreator/layout.mjs",
    "license:inventory": "node scripts/license-inventory.mjs",
    "license:check": "node scripts/license-inventory.mjs --check",
    "test:compliance": "node tests/compliance/notices.mjs",
    "test:docx:autofit": "node --no-warnings tests/docx/autofit.mjs",
    "test:guides": "node --no-warnings --import ./tests/scanner/register.mjs tests/guidance/guides.mjs"
  },
  "dependencies": {
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/server": "^1.3.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vercel/functions": "^3.9.9",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "iso-3166-2": "^1.0.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/caladea": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/cousine": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "@tailwindcss/postcss": "^4",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/iso-3166-2": "^1.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@xmldom/xmldom": "^0.9.12",
    "cfb": "^1.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright-core": "^1.56.1",
    "pptxgenjs": "^4.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
