PORT=4000
NODE_ENV=development
SERVICE_NAME=document-converter-api
LOG_LEVEL=debug
API_BASE_URL=http://localhost:4000

# Neon (Serverless Postgres)
DATABASE_URL=postgresql://user:password@ep-cool-name.us-east-2.aws.neon.tech/converter?sslmode=require
DIRECT_URL=postgresql://user:password@ep-cool-name.us-east-2.aws.neon.tech/converter?sslmode=require

# Local dev without Docker (npm run dev:standalone)
# USE_MEMORY_DB=true
# SKIP_REDIS=true

JWT_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

MAX_FILE_SIZE_MB=25
UPLOAD_DIR=/tmp/uploads
OUTPUT_DIR=/tmp/outputs
FILE_TTL_HOURS=24
QUEUE_CONCURRENCY=3
JOB_TIMEOUT_MS=300000
JOB_ATTEMPTS=3
DEAD_LETTER_QUEUE_NAME=document-conversions-dlq
CACHE_TTL_SECONDS=300

STORAGE_PROVIDER=local
# STORAGE_PROVIDER=s3
# AWS_REGION=us-east-1
# S3_BUCKET=your-bucket
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=

FREE_DAILY_LIMIT=5
ENABLE_WATERMARK_FREE=true
ENABLE_VIRUS_SCAN=false
ENABLE_PREMIUM_GATE=false

OCR_LANGUAGES=eng,spa,fra,deu
CORS_ORIGIN=*

GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
APPLE_CLIENT_ID=com.anonymous.documentscanner
