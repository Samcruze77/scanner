{
  "expo": {
    "name": "Document Scanner",
    "slug": "document-scanner",
    "scheme": "documentscanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.documentscanner",
      "usesAppleSignIn": true
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-notifications",
      "expo-background-fetch",
      "expo-task-manager"
    ],
    "android": {
      "package": "com.anonymous.documentscanner"
    },
    "web": {}
  }
}
